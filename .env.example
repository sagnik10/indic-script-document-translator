# Copy to .env only if your shell or launcher loads dotenv files.
# The application reads DTX_* variables directly from the process environment.
DTX_DEVICE=auto
DTX_LOG_LEVEL=INFO
DTX_HF_LOCAL_FILES_ONLY=false
DTX_PREPROCESSING_PROFILE=auto
DTX_RECONSTRUCTION_MODE=clean_rebuild
DTX_HANDWRITING_LANGUAGE_HINT=auto
DTX_EXPECTED_SOURCE_LANGUAGE=auto
